{
  "name": "ksef-validator-fe",
  "version": "0.1.0",
  "private": true,
  "description": "Web interface of a tool that checks Polish KSeF FA(3) e-invoice XML files.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite-ssg build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:head": "node scripts/check-head.mjs dist",
    "check:inline": "node scripts/check-inline.mjs dist",
    "sync:contract": "node scripts/contract.mjs sync",
    "check:contract": "node scripts/contract.mjs check",
    "gen:api": "openapi-typescript contract/openapi.json --output src/api/schema.d.ts",
    "test:e2e:stack": "playwright test --config playwright.stack.config.ts"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.17",
    "lean-qr": "^2.7.4",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.7",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "zxing-wasm": "^3.1.6"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
